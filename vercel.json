{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "git": {
    "deploymentEnabled": {"**": false, "production": true}
  },
  "functions": {
    "app/vercel.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,infra/**,docs/**,scripts/**,alembic/**,.github/**,.azure/**,.venv/**}"
    }
  }
}
