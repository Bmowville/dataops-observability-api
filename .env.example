APP_NAME="DataOps Observability API"
# Production refuses to start unless INGESTION_API_KEYS contains at least one key.
ENVIRONMENT=local
# Plain postgres:// and postgresql:// provider URLs are normalized to psycopg 3.
DATABASE_URL=sqlite:///./dataops_observability.db
API_PREFIX=/api/v1
RUN_MIGRATIONS_ON_STARTUP=false
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
# Optional comma-separated keys. When set, write/ingestion endpoints require X-DataOps-API-Key.
INGESTION_API_KEYS=
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional comma-separated alert receivers. Failed/canceled runs and warning/failed checks are posted here.
ALERT_WEBHOOK_URLS=
# Optional shared secret sent as X-DataOps-Webhook-Secret to alert receivers.
ALERT_WEBHOOK_SECRET=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5

# Docker Compose Postgres settings. Change POSTGRES_PASSWORD before exposing the service.
POSTGRES_DB=dataops_observability
POSTGRES_USER=dataops
POSTGRES_PASSWORD=change-this-local-password
